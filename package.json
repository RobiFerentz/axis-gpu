{
  "name": "axis-gpu",
  "version": "0.1.0",
  "description": "A TypeScript library for 2D and 3D animation in the browser using WebGPU",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --sourcemap=external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "bun build src/index.ts --outdir dist --target browser --sourcemap=external --watch",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "examples": "bun run build && bun run dev-server.ts"
  },
  "keywords": [
    "webgpu",
    "animation",
    "2d",
    "3d",
    "graphics",
    "canvas",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@webgpu/types": "^0.1.68",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
